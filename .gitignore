# Python bytecode and native extensions
__pycache__/
*.py[cod]
*.pyd
*.so

# Virtual environments
.venv/
venv/

# Centralized tool caches
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Build outputs
build/
dist/
site/
*.egg-info/

# Cython generated C sources
pypmxvmd/common/io/_fast_binary.c
pypmxvmd/common/parsers/_fast_pmx.c
pypmxvmd/common/parsers/_fast_vmd.c

# IDE and operating system files
.idea/
.vscode/
.DS_Store
Thumbs.db

# Local real-world corpus. Tests discover these directories when present.
/tests/data/test_models/
/tests/data/test_vmds/

# Internal development Markdown requires explicit per-commit approval.
/.agents/*.md
/.agents/**/*.md
/docs/*.md
/docs/**/*.md
!/docs/API.md
!/docs/API_CN.md
!/docs/index.md

